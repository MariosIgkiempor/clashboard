    create  table
      "clashboard"."main"."cache_efficiency__dbt_tmp"
  
    
    as (
      -- Share of all input-side tokens that were served from cache.
select day,
       project,
       sum(cache_read_tokens)  as cache_read_tokens,
       sum(cache_write_tokens) as cache_write_tokens,
