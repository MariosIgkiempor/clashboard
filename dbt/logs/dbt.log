    create  table
      "clashboard"."main"."session_summary__dbt_tmp"
  
    
    as (
      with msg as (
    select m.session_id,
           any_value(m.project)                    as project,
           min(m.ts)                               as started_at,
           max(m.ts)                               as ended_at,
           count(*)                                as messages,
           count(*) filter (where m.is_sidechain)  as subagent_messages,
           sum(m.output_tokens)                    as output_tokens,
           sum(m.cache_read_tokens)                as cache_read_tokens,
           sum(m.input_tokens  / 1e6 * p.input_per_mtok
             + m.output_tokens / 1e6 * p.output_per_mtok
             + m.cache_read_tokens  / 1e6 * p.cache_read_per_mtok
             + m.cache_write_tokens / 1e6 * p.cache_write_per_mtok) as cost_usd
    from "clashboard"."main"."stg_messages" m
    left join "clashboard"."main"."prices" p using (model)
    group by m.session_id
),
tools as (
    select session_id, count(*) as tool_calls, count(*) filter (where is_error) as tool_errors
    from "clashboard"."main"."stg_tool_calls"
    group by session_id
)
select msg.*, coalesce(tools.tool_calls, 0) as tool_calls, coalesce(tools.tool_errors, 0) as tool_errors
from msg left join tools using (session_id)
    );
    
  
