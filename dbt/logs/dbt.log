       row_number() over (partition by session_id, is_sidechain order by ts, message_id) as message_index,
       is_sidechain,
       model,
       input_tokens + cache_read_tokens + cache_write_tokens as context_tokens,
       output_tokens
from "clashboard"."main"."int_message_costs"
    );
    
  
