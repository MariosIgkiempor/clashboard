    create  table
      "clashboard"."main"."tool_latency__dbt_tmp"
  
    
    as (
      -- Time between a tool call and its result. Includes time you spent approving the call,
-- so slow tools are often "waiting for a human", not slow code.
select tool_name,
       count(*)                                  as calls,
       quantile_cont(latency_ms, 0.5)  / 1000.0  as p50_seconds,
       quantile_cont(latency_ms, 0.95) / 1000.0  as p95_seconds,
       max(latency_ms) / 1000.0                  as max_seconds
from "clashboard"."main"."stg_tool_calls"
where latency_ms is not null and latency_ms >= 0
group by tool_name
having count(*) >= 20
    );
    
  
