    create  table
      "clashboard"."main"."daily_trends__dbt_tmp"
  
    
    as (
      -- Calendar spine (no gaps) so rolling windows mean "7 days", not "7 active days".
with spine as (
    select unnest(generate_series(min(day), max(day), interval 1 day))::date as day
    from "clashboard"."main"."int_message_costs"
),
daily as (
    select day,
           sum(cost_usd)               as cost_usd,
           count(*)                    as messages,
           sum(output_tokens)          as output_tokens,
           count(distinct session_id)  as sessions,
           count(distinct project)     as projects
    from "clashboard"."main"."int_message_costs"
    group by day
),
filled as (
    select spine.day,
           coalesce(d.cost_usd, 0)      as cost_usd,
           coalesce(d.messages, 0)      as messages,
           coalesce(d.output_tokens, 0) as output_tokens,
           coalesce(d.sessions, 0)      as sessions,
           coalesce(d.projects, 0)      as projects
    from spine left join daily d using (day)
)
select *,
       avg(cost_usd) over (order by day rows between 6 preceding and current row)  as cost_7d_avg,
       sum(cost_usd) over (order by day rows unbounded preceding)                  as cumulative_cost,
       cost_usd - lag(cost_usd) over (order by day)                                as cost_change_vs_prev_day
from filled
    );
    
  
